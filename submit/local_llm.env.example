# Copy to submit/local_llm.env for local testing only.
# Do not commit submit/local_llm.env.

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace_with_runtime_secret
LLM_API_KEY=replace_with_runtime_secret
# Docker/ACR build args use OPENAI_API_KEY; runners also accept LLM_API_KEY.
