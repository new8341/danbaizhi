# Fusai docker image — track 1 (DrugClip hybrid agent, ACR-stable)
# Personal ACR cannot reliably pull 3.4GB PyTorch layers (docker.io / shenjingsuanzi base).
# Runtime: DRUGCLIP_STRATEGY=auto → hybrid_max_qed_v2 (cundang 19.23). Neural needs local build+push.
FROM docker.m.daocloud.io/library/python:3.10-slim

RUN pip install --no-cache-dir rdkit biopandas numpy lmdb tqdm pyyaml

WORKDIR /app

COPY submit/build_info.json /app/submit/build_info.json
COPY submit/ /app/submit/
COPY documen/DrugClip/benchmark/ /app/benchmark/
COPY agent/ /app/agent/
COPY submit/run.sh /app/run.sh

RUN chmod +x /app/run.sh /app/submit/run.sh \
    && python -c "from submit.tracks.registry import get_runner; get_runner('drugclip')"

ENV FUSAI_TRACK=drugclip
ENV DRUGCLIP_BENCHMARK_ROOT=/app/benchmark
ENV DRUGCLIP_STRATEGY=auto
ENV DRUGCLIP_WORKERS=8
ENV SAISDATA=/saisdata
ENV SAISRESULT=/saisresult
ENV PYTHONUNBUFFERED=1

CMD ["sh", "/app/run.sh"]
