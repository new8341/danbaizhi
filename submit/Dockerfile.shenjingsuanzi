# Fusai docker image — track 4 (Shenjingsuanzi) — GPU eval (V100)
FROM pytorch/pytorch:2.1.2-cuda12.1-cudnn8-runtime

RUN pip install --no-cache-dir h5py tqdm matplotlib

WORKDIR /app

# Copy build stamp first so ACR layer cache invalidates on each publish.
COPY submit/build_info.json /app/submit/build_info.json
COPY submit/ /app/submit/
COPY agent/ /app/agent/
COPY submit/tracks/shenjingsuanzi_agent/ /app/agent_code/shenjingsuanzi_agent/
COPY agent/ /app/agent_code/agent/
COPY submit/agent_code/README.md /app/agent_code/README.md
COPY submit/run.sh /app/run.sh

RUN chmod +x /app/run.sh /app/submit/run.sh \
    && python -c "import submit.tracks.registry as r; r.get_runner('shenjingsuanzi')"

# LLM API optional — core PDE inference does not require LLM. See submit/LLM_API_KEY_ACR.md
ARG SHENJING_LLM_API_KEY=""
ARG SHENJING_LLM_BASE_URL=""
ARG SHENJING_LLM_MODEL=""

ENV FUSAI_TRACK=shenjingsuanzi
ENV SHENJING_LLM_API_KEY=${SHENJING_LLM_API_KEY}
ENV SHENJING_LLM_BASE_URL=${SHENJING_LLM_BASE_URL}
ENV SHENJING_LLM_MODEL=${SHENJING_LLM_MODEL}
ENV SHENJING_MODEL=fno
ENV SAISDATA=/saisdata
ENV SAISRESULT=/saisresult
ENV PYTHONUNBUFFERED=1

CMD ["sh", "/app/run.sh"]
