# Fusai docker image — track 4 (Shenjingsuanzi)
FROM registry.cn-shanghai.aliyuncs.com/tcc-public/pytorch:1.1.0-cuda10.0-py3

RUN pip install --no-cache-dir h5py tqdm -i https://pypi.tuna.tsinghua.edu.cn/simple

WORKDIR /app

COPY submit/ /app/submit/
COPY agent/ /app/agent/
COPY submit/run.sh /app/run.sh

RUN chmod +x /app/run.sh /app/submit/run.sh

ENV FUSAI_TRACK=shenjingsuanzi
ENV SHENJING_MODEL=fno
ENV SAISDATA=/saisdata
ENV SAISRESULT=/saisresult
ENV PYTHONUNBUFFERED=1

CMD ["sh", "/app/run.sh"]
