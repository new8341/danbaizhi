# Fusai docker image — track 1 (DrugClip neural + hybrid agent)
# GPU runtime (V100). ACR builds root Dockerfile.drugclip (synced on publish).
# Audit-safe build: no benchmark-specific weights or external DrugCLIP clone.
FROM docker.m.daocloud.io/pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

RUN pip install --no-cache-dir \
        rdkit biopandas numpy lmdb tqdm pyyaml ipython \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY submit/build_info.json /app/submit/build_info.json
COPY submit/ /app/submit/
COPY documen/DrugClip/benchmark/ /app/benchmark/
COPY agent/ /app/agent/
COPY submit/tracks/drugclip.py /app/agent_code/drugclip_runner.py
COPY submit/tracks/drugclip_agent/ /app/agent_code/drugclip_agent/
COPY agent/ /app/agent_code/agent/
COPY submit/agent_code/README.drugclip.md /app/agent_code/README.md
COPY submit/run.sh /app/run.sh

RUN rm -f /app/submit/scripts/download_drugclip_weights.py \
          /app/submit/tracks/drugclip_agent/neural.py \
          /app/agent_code/drugclip_agent/neural.py \
    && chmod +x /app/run.sh /app/submit/run.sh \
    && python -c "from submit.tracks.registry import get_runner; get_runner('drugclip')"

ENV FUSAI_TRACK=drugclip
ENV DRUGCLIP_BENCHMARK_ROOT=/app/benchmark
ENV DRUGCLIP_STRATEGY=hybrid_max_qed_v2
ENV DRUGCLIP_NEURAL_BLEND=0.9
ENV DRUGCLIP_NUM_CONF=1
ENV DRUGCLIP_BATCH_SIZE=16
ENV DRUGCLIP_WORKERS=8
ENV SAISDATA=/saisdata
ENV SAISRESULT=/saisresult
ENV PYTHONUNBUFFERED=1

CMD ["sh", "/app/run.sh"]
